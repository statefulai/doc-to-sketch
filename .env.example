# ============================================================================
# doc-to-sketch 环境配置
# ============================================================================
#
# 使用方式：复制为 .env，取消需要的变量注释并填入值，然后 source .env。
# 注意：脚本不会自动读取 .env 文件，必须 source 或 export 后再运行。
#
# 快速自检：scripts/doctor.sh — 自检当前配置状态，给出保守建议路径。
#
# ============================================================================


# ----------------------------------------------------------------------------
# 图像生成 API（可选 — 让无原生生图的宿主也能出图）
# ----------------------------------------------------------------------------
#
# Codex / Claude Code 有原生图像生成，不需要配这里。
# Cursor、Cline、Windsurf 等需要配置以下变量才能生成图片。
#
# prompt 会通过网络发送到你配置的第三方服务，请注意隐私。
#
# export IMAGE_API_KEY=your_api_key                                    # 如 "sk-xxx" 或 "Bearer sk-xxx"
# export IMAGE_API_URL=https://api.example.com/v1/images/generations   # 完整 endpoint
# export IMAGE_MODEL=gpt-image-2                                       # 可选，默认 gpt-image-2
#
# 配置后验证：
#   scripts/generate_image.sh --prompt-file prompt.txt --size 1920x1080 --output-dir output/


# ----------------------------------------------------------------------------
# 飞书文档读取（可选 — 让 skill 直接从飞书 URL 抓取内容）
# ----------------------------------------------------------------------------
#
# 零配置即可使用：脚本内置了共享应用凭证。
# 首次 fetch 飞书文档时会自动打开浏览器完成 OAuth 授权。
#
# 如需使用自建飞书应用：
#   1. https://open.feishu.cn 创建应用
#   2. 开通权限：docx:document:readonly、wiki:wiki:readonly、offline_access
#   3. 配置 OAuth 回调：http://localhost:19823/callback
#   4. 填入以下凭证：
#
# export FEISHU_APP_ID=your_app_id
# export FEISHU_APP_SECRET=your_app_secret
